{
	"version": "0.2.0",
	"configurations": [

		{
			"type": "node",
			"request": "launch",
			"name": "Launch demo",
			"program": "${workspaceFolder}/examples/index.js",
			"cwd": "${workspaceFolder}",
			"args": [
				"simple"
			]
		},
		{
			"type": "node",
			"request": "launch",
			"name": "Jest",
			"program": "${workspaceFolder}/node_modules/jest/bin/jest.js",
			"args": ["--runInBand"],
			"cwd": "${workspaceFolder}",
			"runtimeArgs": [
				"--nolazy"
			]
		}
	]
}
